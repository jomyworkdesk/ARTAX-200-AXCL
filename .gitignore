SELECT *
FROM E_InboundRequestLog
WHERE InstanceIdentifier IN (
    SELECT InstanceIdentifier
    FROM E_InboundRequestLog
    WHERE InstanceIdentifier IS NOT NULL
    GROUP BY InstanceIdentifier
    HAVING COUNT(*) > 1
)
ORDER BY InstanceIdentifier;

SELECT 
    InstanceIdentifier,
    COUNT(*) AS DuplicateCount
FROM E_InboundRequestLog
WHERE InstanceIdentifier IS NOT NULL
GROUP BY InstanceIdentifier
HAVING COUNT(*) > 1
ORDER BY DuplicateCount DESC;