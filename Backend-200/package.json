  "type": "commonjs",
  "engines": {
    "node": "16.20.2",
    "npm": "8.19.4"
  },
  "pkg": {
    "scripts": [
      "app.js",
      "config/**/*.js",
      "controllers/**/*.js",
      "CronJobs/**/*.js",
      "services/**/*.js",
      "repositories/**/*.js",
      "routes/**/*.js",
